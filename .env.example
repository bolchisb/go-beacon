# Copy to .env next to docker-compose.prod.yml and adjust.

# Image tag to deploy. Required, no default: an unpinned production deploy is
# not reproducible. Use "develop" for the rolling build, a git tag for a release.
BEACON_IMAGE_TAG=develop

# Host address the relay is published on. Keep 127.0.0.1 while a reverse proxy
# runs on the same host; set it to the interface the proxy reaches otherwise.
BEACON_BIND=127.0.0.1

# Host port. The container always listens on 8080 internally.
BEACON_PORT=8080
