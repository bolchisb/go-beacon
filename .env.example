# Copy to .env next to docker-compose.prod.yml and adjust.

# Image tag to deploy. Required, no default: an unpinned production deploy is
# not reproducible. Use "develop" for the rolling build, a git tag for a release.
BEACON_IMAGE_TAG=develop

# Host address the relay is published on. Keep 127.0.0.1 while a reverse proxy
# runs on the same host; set it to the interface the proxy reaches otherwise.
BEACON_BIND=127.0.0.1

# Host port. The container always listens on 8080 internally.
BEACON_PORT=8080

# ---------------------------------------------------------------------------
# Operator authentication
# ---------------------------------------------------------------------------
# Gates /ui, /api and /mcp -- all three grant command execution on every
# connected machine, so this is the single most important value in this file.
# Generate one and do not reuse it anywhere:
#
#   openssl rand -base64 32
#
# Rotating it signs every operator out immediately, which is also the only
# revocation mechanism there is until per-operator tokens land.
BEACON_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------
# There is deliberately nothing here for authenticating to Vault. Vault Agent
# does that: the unseal supervisor mints a response-wrapped, single-use secret
# id, Agent exchanges it for a short-lived token, and the relay reads only that
# token. No long-lived credential lands in this file or in any environment.
#
# Run `make vault-init` once after the first start to create the transit key,
# the policy and the AppRole.

# The transit key that signs agent assertions. Change it only if bootstrap.sh
# was run with BEACON_TRANSIT_KEY set to something else.
BEACON_TRANSIT_KEY=beacon-agent-assertions
